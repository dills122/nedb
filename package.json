  "description": "File-based embedded data store for node.js",
  "keywords": [
    "database",
    "datastore",
    "embedded"
  ],
  "homepage": "https://github.com/dills122/nedb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dills122/nedb.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@yetzt/binary-search-tree": "^0.2.6",
    "async": "^3.2.6",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "commander": "9.5.0",
    "underscore": "^1.13.8",
    "exec-time": "0.0.4",
    "mocha": "10.8.2",
    "sinon": "15.2.0"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "js-yaml": "4.3.1",
    "picomatch": "2.3.2"
